# Safe placeholders only. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
# Add your Groq API key privately to the server environment; never commit it.
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
# Optional; only the official Groq HTTPS API host is accepted.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional local SQLite database file; hosted SQLite is not durable.
ADAPTIVE_AI_DB_PATH=adaptive_ai.sqlite3
# Set this to the dedicated Adaptive AI Neon PostgreSQL connection string when hosted.
DATABASE_URL=
# Required when APP_ENV=production; use a long random secret.
ADAPTIVE_AI_API_TOKEN=
